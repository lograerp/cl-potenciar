<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="trial_balance_monthly_wizard" model="ir.ui.view">
        <field name="name">Sumas y saldos mensual</field>
        <field name="model">trial.balance.report.wizard</field>
        <field name="inherit_id" ref="account_financial_report.trial_balance_wizard" />
        <field name="mode">primary</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <!-- Opciones que el reporte mensual no soporta -->
            <xpath expr="(//field[@name='grouped_by'])[2]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <field name="show_partner_details" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="foreign_currency" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <xpath expr="//footer/div[1]" position="replace">
                <div
                    attrs="{'invisible': [('not_only_one_unaffected_earnings_account', '=', True)]}"
                >
                    <button
                        name="button_export_monthly_html"
                        string="Ver"
                        type="object"
                        default_focus="1"
                        class="oe_highlight"
                    />
                    o
                    <button
                        name="button_export_monthly_xlsx"
                        string="Exportar XLSX"
                        type="object"
                    />
                    o
                    <button string="Cancelar" class="oe_link" special="cancel" />
                </div>
            </xpath>
        </field>
    </record>
    <record id="action_trial_balance_monthly_wizard" model="ir.actions.act_window">
        <field name="name">Sumas y saldos mensual</field>
        <field name="res_model">trial.balance.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="trial_balance_monthly_wizard" />
        <field name="target">new</field>
    </record>
    <menuitem
        id="menu_trial_balance_monthly_wizard"
        parent="account_financial_report.menu_oca_reports"
        action="action_trial_balance_monthly_wizard"
        sequence="21"
    />
</odoo>
