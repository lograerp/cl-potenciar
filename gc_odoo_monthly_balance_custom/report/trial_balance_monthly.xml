<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Hoja ancha para que entren las columnas de los 12 meses al imprimir -->
    <record id="paperformat_trial_balance_monthly" model="report.paperformat">
        <field name="name">Sumas y saldos mensual</field>
        <field name="format">A3</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">8</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">10</field>
        <field name="dpi">110</field>
    </record>
    <record id="action_report_trial_balance_monthly_html" model="ir.actions.report">
        <field name="name">Sumas y saldos mensual</field>
        <field name="model">trial.balance.report.wizard</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">gc_odoo_monthly_balance_custom.trial_balance_monthly</field>
        <field name="report_file">gc_odoo_monthly_balance_custom.trial_balance_monthly</field>
        <field name="paperformat_id" ref="paperformat_trial_balance_monthly" />
    </record>
    <record id="action_report_trial_balance_monthly_xlsx" model="ir.actions.report">
        <field name="name">Sumas y saldos mensual XLSX</field>
        <field name="model">trial.balance.report.wizard</field>
        <field name="type">ir.actions.report</field>
        <field
            name="report_name"
        >gc_odoo_monthly_balance_custom.trial_balance_xlsx</field>
        <field name="report_type">xlsx</field>
        <field name="report_file">sumas_y_saldos_mensual</field>
    </record>
</odoo>
